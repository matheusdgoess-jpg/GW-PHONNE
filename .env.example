# Copie estas variáveis para Vercel → Settings → Environment Variables (Production)

# Criado automaticamente ao conectar o Blob Storage no dashboard da Vercel
BLOB_READ_WRITE_TOKEN=

# Login do painel /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Chave usada para assinar a sessão de login. Gere uma string aleatória longa.
AUTH_SECRET=
